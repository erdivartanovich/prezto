#!/bin/bash

# Array of alias names to be unalias
alias_names=("e" "esudo") # Add your alias names here
# Loop through each alias to unalias them
for alias_name in "${alias_names[@]}"; do
	# Check if the alias exists
	if alias "$alias_name" &>/dev/null; then
		# If the alias exists, unalias it
		unalias "$alias_name"
	fi
done

# -- e --: edit in $EDITOR
e() {
	if [ ! "$1" ]; then
		fzf --multi --bind "enter:become($EDITOR {})"
		return
	fi
	if [ -e "$1" ]; then
		"$EDITOR" "$1"
	else
		dir=$(zoxide query "$1")
		if [ -d "$dir" ]; then
			cd "$dir" && fzf --multi --bind "enter:become($EDITOR {})"
		else
			$EDITOR "$1"
		fi
	fi
}

esudo() {
	if [ ! "$1" ]; then
		fzf --multi --bind "enter:become(sudo -E $EDITOR {})"
		return
	fi
	if [ -e "$1" ]; then
		sudo -E $EDITOR "$1"
	else
		dir=$(zoxide query "$1")
		if [ -d "$dir"]; then
			cd "$dir" && fzf --multi --bind "enter:become(sudo -E $EDITOR {})"
		else
			sudo -E "$EDITOR" "$1"
		fi
	fi
}

