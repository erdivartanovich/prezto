# Find file

# Find in file
fif() {
	dir="${1:-.}"
	cd "$dir"
	RG_DEFAULT_COMMAND="rg -i -l --no-ignore-vcs --no-follow -g '!{.git,node_modules}'"
	result=$(FZF_DEFAULT_COMMAND="rg --files" fzf \
		-m \
		-e \
		--ansi \
		--phony \
		--bind "change:reload:$RG_DEFAULT_COMMAND {q} || true" \
		--preview "rg -i --pretty --context 5 --line-number {q} {}" | cut -d":" -f1,2)
	[[ -n "$result" ]] && "$EDITOR" "$result" || return
}

# File finder
ff() {
	FZF_DEFAULT_COMMAND="fd \"$PATTERN\" --type f \
     --exclude node_modules \
     --exclude .git \
     -H $ROOT_PATH"
	result=$(fzf --preview-window='right:60%:nohidden' \
		--preview "bat {};" \
		--bind 'enter:execute(echo {};)+abort')
	[[ -n "$result" ]] && "$EDITOR" "$result" || return
}

# Display audio visualizer with glava
# while choosing/change glava backend source
viz() {
	source=$(pactl list sinks short | awk '{print $2}' | fzf)
	sed -i "s/^\(#request setsource\) \"[^\"]*\"/\1 \"$source.monitor\"/" ~/.config/glava/rc.glsl
	pkill glava &>/dev/null
	glava --desktop &>/dev/null &
	disown
}

calc() {
	rofi -show calc -modi calc
}

sysinfo() {
	neofetch --ascii $HOME/.config/neofetch/arch-ascii-2
	task
}
